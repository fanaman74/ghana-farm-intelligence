# Ghana Farm Intelligence — environment
# Copy to .env (Docker Compose reads it automatically) or set these in Railway.

# development | production
GFI_ENV=development

# Where SQLite, provider caches and imagery chips are written.
# Relative paths are resolved against backend/, so "./data" is backend/data.
# Docker/Railway point this at the mounted volume (/data).
GFI_DATA_DIR=./data

# Optional explicit paths (defaults are derived from GFI_DATA_DIR).
# GFI_DB_PATH=
# GFI_STATIC_DIR=

# Administrator token for advisories and market prices.
# Leave empty for a trusted local deployment; set it for anything public.
GFI_ADMIN_TOKEN=

# Shared access token for the private API (farm boundaries, fields, records,
# analyses, layers, jobs). Leave empty for a trusted local deployment. When set,
# the web client asks for it once and sends X-Access-Token; reference data, health
# and rendered PNGs stay public. Ignored once accounts exist (see below).
# GFI_ACCESS_TOKEN=

# Accounts (optional). Set these once to create the first administrator; after
# that, that administrator creates every other account in Settings → Accounts and
# decides who else is an administrator. Each account sees only its own farms, and
# administrators see all of them.
# GFI_ADMIN_USER=admin
# GFI_ADMIN_PASSWORD=change-me-please
# Session lifetime in seconds (default 14 days).
# GFI_SESSION_TTL=1209600
# Set to 1 when the app is served over HTTPS so the session cookie is Secure.
# GFI_COOKIE_SECURE=1

# Which proxy addresses may set X-Forwarded-For (comma separated). The container
# defaults to the loopback only; Railway and similar platforms need their proxy
# range here (or "*").
# GFI_FORWARDED_ALLOW_IPS=*

# Additional browser origins allowed to call the API (comma separated).
# Same-origin deployments do not need this.
GFI_CORS_ORIGINS=

# Provider behaviour
GFI_ALLOW_NETWORK=true
GFI_PROVIDER_TIMEOUT=45
GFI_PROVIDER_RETRIES=2
GFI_JOB_WORKERS=3
# A job that runs longer than this fails with an explanation instead of hanging.
GFI_ANALYSIS_TIMEOUT=300

# Cache lifetimes (seconds)
GFI_ANALYSIS_CACHE_TTL=10800
GFI_WEATHER_CACHE_TTL=1800
GFI_SOIL_CACHE_TTL=2592000
GFI_RAINFALL_CACHE_TTL=43200
GFI_IMAGERY_CACHE_TTL=21600

# Boundary limits
GFI_MIN_AREA_HA=0.005
GFI_MAX_AREA_HA=50000
# A stored boundary may be large, but analysing one is a raster read per band:
# above this area the analysis is refused with an explanation instead of timing out.
GFI_MAX_ANALYSIS_HA=20000

# Allow the clearly labelled sample boundary
GFI_ALLOW_DEMO_DATA=true

GFI_LOG_LEVEL=INFO
